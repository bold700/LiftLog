rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }
    function isTrainerOrAdmin() {
      return isSignedIn() && (myProfile().role == 'trainer' || myProfile().role == 'admin');
    }
    /** Velden die alleen een beheerder mag zetten: rol en de verificatie-bypass. */
    function touchesProtectedProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'createdByAdmin']);
    }

    // Profielen.
    // - Lezen: eigen profiel, je eigen sporters, en trainers/beheerders (ledenlijst, ranglijst).
    // - Aanmaken: je eigen profiel, altijd als sporter (trainer worden gaat via een aanvraag die een
    //   beheerder goedkeurt), of door een beheerder (Beheer → account aanmaken). Zo kan niemand
    //   zichzelf trainer of beheerder maken.
    // - Bijwerken: jezelf (behalve rol), een trainer mag sporterprofielen bijwerken (behalve rol),
    //   een beheerder mag alles.
    match /profiles/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId
            || resource.data.trainerId == request.auth.uid
            || isTrainerOrAdmin());
      allow create: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == userId
            && request.resource.data.get('role', 'sporter') == 'sporter'
            && request.resource.data.get('createdByAdmin', false) == false);
      allow update: if isSignedIn()
        && (isAdmin()
            || (request.auth.uid == userId && !touchesProtectedProfileFields())
            || (isTrainerOrAdmin() && resource.data.role == 'sporter' && !touchesProtectedProfileFields()));
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
    // Koppelsleutels voor AI-chats (MCP). Doc-id = SHA-256 van de sleutel; alleen de eigenaar beheert ze.
    // De server (Admin SDK) leest ze om de gebruiker te herkennen.
    match /mcpKeys/{keyId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    // Workouts: alleen eigen (trainer of toegewezen sporter)
    match /workouts/{workoutId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid
            || resource.data.clientId == request.auth.uid
            || request.auth.uid in resource.data.get('participantIds', [])
            || resource.data.get('audience', 'single') == 'open');
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.trainerId == request.auth.uid;
    }
    // Openbare ranglijst: alleen geaggregeerde totalen; iedere ingelogde gebruiker mag lezen.
    // Schrijven alleen eigen document (client zet visibility + label; geen ruwe logs).
    function isAllowedPhotoUrl(url) {
      return url is string
        && url.size() <= 600
        && (url == ''
            || url.matches('https://firebasestorage[.]googleapis[.]com/.*')
            || url.matches('https://lh[0-9][.]googleusercontent[.]com/.*'));
    }
    match /leaderboardPublic/{userId} {
      allow read: if request.auth != null;
      // Alleen het eigen document, met een naam van beperkte lengte en een foto van onze eigen opslag
      // (geen willekeurige externe plaatjes of namen van anderen op de ranglijst).
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.displayLabel is string
        && request.resource.data.displayLabel.size() <= 60
        && request.resource.data.visibility in ['anonymous', 'named']
        && isAllowedPhotoUrl(request.resource.data.get('photoURL', ''));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Per-persoon oefening-logs (groepsles + individueel). Eigen logs of via je trainer/admin.
    // Aanmaken voor een ander kan alleen als trainer/beheerder (bv. tijdens een groepsles).
    match /logs/{logId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.trainerId == request.auth.uid
            || isTrainerOrAdmin());
      allow create: if request.auth != null
        && (request.resource.data.userId == request.auth.uid
            || (isTrainerOrAdmin() && request.resource.data.loggedBy == request.auth.uid));
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isTrainerOrAdmin());
    }

    // Check-ins na een training (hoe voelde het, waar moet de trainer op letten). Zelfde regels als logs.
    match /checkins/{checkinId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.trainerId == request.auth.uid
            || isTrainerOrAdmin());
      allow create: if request.auth != null
        && (request.resource.data.userId == request.auth.uid
            || (isTrainerOrAdmin() && request.resource.data.loggedBy == request.auth.uid));
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isTrainerOrAdmin());
    }

    // Voeding-logs per persoon (Open Food Facts). Eigen logs of via je trainer/admin.
    match /nutritionLogs/{logId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.trainerId == request.auth.uid
            || isTrainerOrAdmin());
      allow create: if request.auth != null
        && (request.resource.data.userId == request.auth.uid
            || (isTrainerOrAdmin() && request.resource.data.loggedBy == request.auth.uid));
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isTrainerOrAdmin());
    }

    // Lichaamsmetingen (gewicht, vet%) per persoon. Eigen data of via je trainer/admin.
    match /measurements/{mId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.trainerId == request.auth.uid
            || isTrainerOrAdmin());
      allow create: if request.auth != null
        && (request.resource.data.userId == request.auth.uid
            || (isTrainerOrAdmin() && request.resource.data.loggedBy == request.auth.uid));
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isTrainerOrAdmin());
    }

    // Workout-aanvragen: sporter maakt eigen aanvraag; trainer/admin ziet en handelt af.
    match /workoutRequests/{reqId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isTrainerOrAdmin());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isTrainerOrAdmin());
    }

    // Groepsles-sessies. Trainer beheert; deelnemers mogen hun sessie lezen.
    match /sessions/{sessionId} {
      allow read: if request.auth != null
        && (resource.data.trainerId == request.auth.uid
            || request.auth.uid in resource.data.participantIds
            || isTrainerOrAdmin());
      allow create: if request.auth != null
        && request.resource.data.trainerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.trainerId == request.auth.uid
            || isTrainerOrAdmin());
    }
  }
}
