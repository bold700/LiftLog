rules_version = '2';

// Firebase Storage-regels voor LiftLog (project vanas-d1a25).
// Deze rollen automatisch uit via GitHub Actions bij een wijziging op main (zie
// .github/workflows/ci.yml, job "Firestore- en storage-regels uitrollen"). Lukt dat niet
// (403, ontbrekende IAM-rol), dan blijft het bij een waarschuwing in die run — zie
// docs/ROLLEN-EN-RECHTEN.md. Los uitrollen kan ook: npm run deploy:storage (na firebase login),
// of plakken in Firebase Console → Storage → Rules.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role;
    }

    function isTrainerOrAdmin() {
      return signedIn() && (myRole() == 'trainer' || myRole() == 'admin');
    }

    function isImageUnder(maxBytes) {
      return request.resource.contentType.matches('image/.*') && request.resource.size < maxBytes;
    }

    // Oefening-GIF's: eigen ExerciseDB-dataset, publiek leesbaar (URL's met ?alt=media zonder token).
    match /exercises/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    function myOrgId() {
      return firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.orgId;
    }

    // Voor cross-studio isolatie bij `progress` hieronder: welke studio's iemand meetelt, net als
    // `myOrgs()`/`sameOrg()` in firestore.rules. Zonder dit zou een trainer van studio B de
    // voortgangsfoto's van een sporter in studio A kunnen lezen zolang hij het pad kent — dat mag
    // nooit, ook al is de foto op zich geen geheim binnen de eigen studio.
    function defaultOrg() {
      return 'vanas';
    }
    function orgIdsOf(profileData) {
      return profileData.get('orgIds', [profileData.get('orgId', defaultOrg())]);
    }
    function isStaffInSameOrgAs(uid) {
      return isTrainerOrAdmin()
        && orgIdsOf(firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data)
             .hasAny(orgIdsOf(firestore.get(/databases/(default)/documents/profiles/$(uid)).data));
    }

    // Studiologo: publiek leesbaar (staat straks ook op de inlogpagina), alleen een beheerder van
    // díe studio schrijft. Een logo is klein; 2 MB is ruim.
    match /orgLogos/{orgId} {
      allow read: if true;
      allow write: if signedIn() && myRole() == 'admin' && myOrgId() == orgId
        && (request.resource == null || isImageUnder(2 * 1024 * 1024));
    }

    // Drukversie van het logo (PNG) voor facturen en mail; de app maakt hem zelf bij het uploaden.
    match /orgLogos/print/{orgId} {
      allow read: if true;
      allow write: if signedIn() && myRole() == 'admin' && myOrgId() == orgId
        && (request.resource == null || isImageUnder(2 * 1024 * 1024));
    }

    // Profielfoto's: iedereen die is ingelogd mag ze zien (ranglijst). Schrijven mag de eigenaar
    // zelf, en verder trainers/beheerders van diens eigen studio — nodig sinds "Bekijk als" op
    // Profiel de gegevens van een sporter volledig bewerkbaar maakt, inclusief de foto.
    match /avatars/{uid} {
      allow read: if signedIn();
      allow write: if signedIn()
        && (request.auth.uid == uid || isStaffInSameOrgAs(uid))
        && isImageUnder(5 * 1024 * 1024);
    }

    // Voortgangsfoto's bij metingen: alleen de sporter zelf en trainers/beheerders van diens eigen
    // studio (isStaffInSameOrgAs, niet zomaar isTrainerOrAdmin() — anders zou elke trainer van elke
    // studio deze kunnen lezen zolang hij het pad kent).
    match /progress/{uid}/{measurementId}/{view} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaffInSameOrgAs(uid));
      allow write: if signedIn()
        && (request.auth.uid == uid || isStaffInSameOrgAs(uid))
        && (request.resource == null || isImageUnder(5 * 1024 * 1024));
    }
  }
}
