{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/generate-workout.mjs": {
      "includeFiles": "src/data/*.json",
      "maxDuration": 60
    },
    "api/exercise-demo.mjs": {
      "includeFiles": "src/data/*.json"
    },
    "api/exercise-search.mjs": {
      "includeFiles": "src/data/*.json"
    },
    "api/exercise-gif.mjs": {
      "includeFiles": "src/data/*.json",
      "maxDuration": 30
    },
    "api/food-photo.mjs": {
      "maxDuration": 30
    },
    "api/assistant.mjs": {
      "includeFiles": "src/data/*.json",
      "maxDuration": 60
    },
    "api/notify.mjs": {
      "maxDuration": 15
    },
    "api/booking.mjs": {
      "maxDuration": 30
    },
    "api/bodyscan-photo.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/generate-classes",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/class-reminders",
      "schedule": "0 16 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/f/:token",
      "destination": "/api/booking?invoice=:token"
    },
    {
      "source": "/kalender/:token",
      "destination": "/api/booking?feed=:token"
    },
    {
      "source": "/mollie-webhook/:orgId",
      "destination": "/api/booking?mollieWebhook=:orgId"
    },
    {
      "source": "/api/cron/generate-classes",
      "destination": "/api/booking?cron=generateClasses"
    },
    {
      "source": "/api/cron/class-reminders",
      "destination": "/api/booking?cron=classReminders"
    },
    {
      "source": "/api/mcp/:key",
      "destination": "/api/mcp?key=:key"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
