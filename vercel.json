{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/generate-workout.mjs": {
      "includeFiles": "src/data/*.json",
      "maxDuration": 60
    },
    "api/exercise-demo.mjs": {
      "includeFiles": "src/data/*.json"
    },
    "api/exercise-search.mjs": {
      "includeFiles": "src/data/*.json"
    },
    "api/exercise-gif.mjs": {
      "includeFiles": "src/data/*.json",
      "maxDuration": 30
    },
    "api/food-photo.mjs": {
      "maxDuration": 30
    },
    "api/assistant.mjs": {
      "includeFiles": "src/data/*.json",
      "maxDuration": 60
    },
    "api/notify.mjs": {
      "maxDuration": 15
    },
    "api/booking.mjs": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/mcp/:key",
      "destination": "/api/mcp?key=:key"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
